body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f4f4f4;
}

header {
    background-color: #222;
    color: white;
    padding: 20px;
}

header h1 {
    margin: 0;
}

.layout {
    display: flex;
    min-height: calc(100vh - 78px);
}

.menu {
    width: 220px;
    background-color: #333;
    padding: 20px;
}

.menu h2 {
    color: white;
}

.menu a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 12px;
    margin-bottom: 5px;
}

.menu a:hover {
    background-color: #555;
}

main {
    flex: 1;
    padding: 30px;
}
